<Project Sdk="Kiln.Sdk/0.2.0-dev.28">
  <!-- A lab check, not part of the mod: [KilnTest] methods that read, in a running server, the game data the mod patched.
       Deploy it with "kiln deploy tests/LabTest" and run it with "kiln test more-flame-altars-labtest", both with the
       lab's name as the server. -->
  <PropertyGroup>
    <KilnModId>more-flame-altars-labtest</KilnModId>
    <KilnModName>More Flame Altars lab test</KilnModName>
    <Version>0.1.0</Version>
    <KilnSide>server</KilnSide>
    <KilnServices>Assets;Quests;Testing;Hooks</KilnServices>
    <KilnAdvanced>true</KilnAdvanced>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <KilnGameIds>None</KilnGameIds>
  </PropertyGroup>
</Project>
