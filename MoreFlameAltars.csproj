<Project Sdk="Kiln.Sdk/0.2.0-dev.29.18">
  <!-- More Flame Altars: 16 Flame Altars at every Flame level, optionally more water sources and bigger build areas. One
       boot-time change of the game's balancing table (Mod.OnBoot, a ResourcePatchBlock): Kiln 0.2.0-dev.29.18 or later.
         dotnet build -t:KilnDeploy -p:KilnServer=<server folder>
         dotnet build -c Release -t:KilnPack -p:KilnPackageOutputPath=dist/      (the zip the launcher's Library imports)
       KilnBoot writes "boot": true into the generated kiln.mod.json: the mod's OnBoot runs before the game reads its data.
       The Kiln.Sdk version above must be one your NuGet feed has (nuget.config): the Kiln release's sdk/ folder. -->
  <PropertyGroup>
    <KilnModId>more-flame-altars</KilnModId>
    <KilnModName>More Flame Altars</KilnModName>
    <Version>0.4.3</Version>
    <Description>16 Flame Altars at every Flame level, where the game gives a new world 2 and reaches 16 only at Flame level 11. The number is a setting; up to 128 (experimental), optionally as one merged base past 16 zones. Bigger build areas around every altar, up to twice the game's size with each side capped at 239 m.</Description>
    <Authors>Frostdev</Authors>
    <AssemblyName>MoreFlameAltars</AssemblyName>
    <RootNamespace>MoreFlameAltars</RootNamespace>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <KilnSide>both</KilnSide>
    <!-- the balancing table is read by the server and by every player's game: both need the mod -->
    <KilnClients>mod</KilnClients>
    <!-- the game reads the table once, at its start: the change is made in the boot phase -->
    <KilnBoot>true</KilnBoot>
    <!-- Kiln.Hooks for beyondSixteen (the game's altar-limit function; off by default) and mergeBases (the game's base
         system, BaseMergeHook.cs): needs the advanced tier -->
    <KilnAdvanced>true</KilnAdvanced>
    <KilnServices>Blocks;Quests;Network;Ui;Chat;Permissions;Hooks;Client;Assets</KilnServices>
    <KilnGameIds>None</KilnGameIds>
    <!-- BaseMergeHook.cs reads and writes the game's base system through pointers -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- nothing to bake (no quests, skill nodes or VFX defined in code); the dev.28 bake host crashes on this machine
         (KILN032, TypeInitializationException in <Module>), and turning it off leaves the package the same -->
    <KilnBake>false</KilnBake>
    <!-- release builds carry no build-machine paths: the DLL's PDB path and the PDB's source paths start at /_/ -->
    <ContinuousIntegrationBuild Condition="'$(Configuration)' == 'Release'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <ItemGroup>
    <!-- lets the analyzers see KilnBoot on early dev.28 SDK builds, which left it out (KILN034); a duplicate is harmless -->
    <!-- where the SDK declares it itself -->

    <CompilerVisibleProperty Include="KilnBoot" />
    <!-- tests/LabTest is its own mod (a lab check), built separately; eml/ is the start-up data version for older Kiln -->
    <Compile Remove="tests/**" />
    <None Remove="tests/**" />
    <None Remove="eml/**" />
    <None Remove="dist/**" />
    <None Include="sigdb/*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
